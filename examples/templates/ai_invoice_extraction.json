{
  "name": "AI Invoice Extraction",
  "description": "Invoice text (from an email parser or OCR service) is posted to a webhook. AI extracts the vendor, number, dates, totals and line items against a JSON Schema, and a wrong answer is retried with the schema errors. Invoices over 10,000 wait for a person to approve them. Everything else goes straight into PostgreSQL. Set the ANTHROPIC_API_KEY and INVOICE_DB_PASSWORD secrets in your vhost before starting.",
  "icon": "IconDatabase",
  "color": "teal",
  "data": {
    "workflow": {
      "id": "ai-invoice-extraction",
      "name": "AI Invoice Extraction",
      "nodes": [
        {
          "id": "src_invoice",
          "type": "source",
          "ref_id": "ai-invoice-inbound",
          "config": { "label": "Invoice In" },
          "x": 80,
          "y": 220
        },
        {
          "id": "extract",
          "type": "transformation",
          "config": {
            "label": "Extract Invoice Fields",
            "transType": "ai_extract",
            "provider": "anthropic",
            "model": "claude-opus-5-5",
            "apiKey": "{{secret(\"ANTHROPIC_API_KEY\")}}",
            "instructions": "Extract the invoice. Dates are YYYY-MM-DD. Amounts are numbers without currency symbols.",
            "inputFields": ["text", "filename"],
            "targetField": "",
            "maskPII": true,
            "schema": {
              "type": "object",
              "properties": {
                "vendor": { "type": "string" },
                "invoice_number": { "type": "string" },
                "invoice_date": { "type": ["string", "null"] },
                "due_date": { "type": ["string", "null"] },
                "currency": { "type": "string" },
                "subtotal": { "type": ["number", "null"] },
                "tax": { "type": ["number", "null"] },
                "total": { "type": "number" },
                "line_items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "description": { "type": "string" },
                      "quantity": { "type": ["number", "null"] },
                      "amount": { "type": "number" }
                    },
                    "required": ["description", "amount"]
                  }
                }
              },
              "required": ["vendor", "invoice_number", "currency", "total", "line_items"]
            },
            "retry": { "maxAttempts": 3, "backoff": "2s", "maxBackoff": "30s" }
          },
          "x": 340,
          "y": 220
        },
        {
          "id": "high_value",
          "type": "condition",
          "config": {
            "label": "Total Over 10,000?",
            "conditions": [{ "field": "total", "operator": ">", "value": "10000" }]
          },
          "x": 600,
          "y": 220
        },
        {
          "id": "approve",
          "type": "approval",
          "config": { "label": "Approve High-Value Invoice" },
          "x": 860,
          "y": 100
        },
        {
          "id": "store",
          "type": "sink",
          "ref_id": "ai-invoice-db",
          "config": { "label": "Invoices Table" },
          "x": 1120,
          "y": 220
        }
      ],
      "edges": [
        { "id": "e1", "source_id": "src_invoice", "target_id": "extract" },
        { "id": "e2", "source_id": "extract", "target_id": "high_value" },
        { "id": "e3", "source_id": "high_value", "target_id": "approve", "source_handle": "true" },
        { "id": "e4", "source_id": "high_value", "target_id": "store", "source_handle": "false" },
        { "id": "e5", "source_id": "approve", "target_id": "store", "source_handle": "approved" }
      ]
    },
    "sources": [
      {
        "id": "ai-invoice-inbound",
        "name": "Invoice Webhook",
        "type": "webhook",
        "active": true,
        "config": { "path": "/api/webhooks/invoices" }
      }
    ],
    "sinks": [
      {
        "id": "ai-invoice-db",
        "name": "Invoices Database",
        "type": "postgres",
        "active": true,
        "config": {
          "host": "localhost",
          "port": "5432",
          "user": "hermod",
          "password": "secret:INVOICE_DB_PASSWORD",
          "dbname": "finance",
          "table": "invoices"
        }
      }
    ]
  }
}
