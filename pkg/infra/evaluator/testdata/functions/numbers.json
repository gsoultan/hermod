{
  "_comment": [
    "floor, ceil, mod, pow, min, max, clamp and format_number, as the engine runs",
    "them. Every file in this directory is read by",
    "pkg/infra/evaluator/function_fixture_test.go; each case is a whole",
    "expression evaluated against `source`.",
    "",
    "As in add, sub and mul, a value that is not a number reads as 0 -- except",
    "in min and max, which skip it, and format_number, which is null for it.",
    "What has no answer is null: mod by 0, and a pow with no finite result.",
    "min and max take any number of values and the items of a list.",
    "format_number rounds half away from zero, as round() does, and writes the",
    "separators of en, de, fr, id, it or nl; an unknown locale is null. A",
    "result that would be -0 is 0: JSON would write it as -0."
  ],
  "source": {
    "price": 12.5,
    "neg": -12.5,
    "qty": 3,
    "text": "7.9",
    "word": "abc",
    "big": 1234567.891,
    "list": [4, 1, 9]
  },
  "cases": [
    { "name": "floor: a decimal", "expr": "floor(source.price)", "want": 12 },
    { "name": "floor: a negative goes down", "expr": "floor(source.neg)", "want": -13 },
    { "name": "floor: text holding a number", "expr": "floor(source.text)", "want": 7 },
    { "name": "floor: not a number is 0, as in add", "expr": "floor(source.word)", "want": 0 },
    { "name": "floor: no arguments", "expr": "floor()", "want": null },
    { "name": "ceil: a decimal", "expr": "ceil(source.price)", "want": 13 },
    { "name": "ceil: a negative goes up", "expr": "ceil(source.neg)", "want": -12 },
    { "name": "ceil: just under zero is 0, not -0", "expr": "ceil(-0.5)", "want": 0 },
    { "name": "ceil: not a number is 0", "expr": "ceil(source.word)", "want": 0 },
    { "name": "ceil: no arguments", "expr": "ceil()", "want": null },

    { "name": "mod: remainder", "expr": "mod(10, 3)", "want": 1 },
    { "name": "mod: takes the sign of the first", "expr": "mod(-10, 3)", "want": -1 },
    { "name": "mod: no remainder is 0, not -0", "expr": "mod(-10, 5)", "want": 0 },
    { "name": "mod: decimals", "expr": "mod(source.price, 5)", "want": 2.5 },
    { "name": "mod: by zero is null, as div is", "expr": "mod(10, 0)", "want": null },
    { "name": "mod: one argument", "expr": "mod(10)", "want": null },

    { "name": "pow: a power", "expr": "pow(2, 10)", "want": 1024 },
    { "name": "pow: a field", "expr": "pow(source.qty, 2)", "want": 9 },
    { "name": "pow: a root", "expr": "pow(4, 0.5)", "want": 2 },
    { "name": "pow: no real answer is null", "expr": "pow(-8, 0.5)", "want": null },
    { "name": "pow: too large is null", "expr": "pow(10, 400)", "want": null },
    { "name": "pow: one argument", "expr": "pow(2)", "want": null },

    { "name": "min: of values", "expr": "min(source.qty, source.price, 5)", "want": 3 },
    { "name": "min: of a list", "expr": "min(source.list)", "want": 1 },
    { "name": "min: skips what is not a number", "expr": "min(source.word, 2)", "want": 2 },
    { "name": "min: nothing that is a number", "expr": "min(source.word)", "want": null },
    { "name": "min: no arguments", "expr": "min()", "want": null },
    { "name": "max: of a list", "expr": "max(source.list)", "want": 9 },
    { "name": "max: text holding a number", "expr": "max(source.qty, source.text)", "want": 7.9 },
    { "name": "max: skips a missing field", "expr": "max(1, source.missing)", "want": 1 },
    { "name": "max: no arguments", "expr": "max()", "want": null },

    { "name": "clamp: above the range", "expr": "clamp(15, 0, 10)", "want": 10 },
    { "name": "clamp: below the range", "expr": "clamp(-5, 0, 10)", "want": 0 },
    { "name": "clamp: inside the range", "expr": "clamp(5, 0, 10)", "want": 5 },
    { "name": "clamp: text holding a number", "expr": "clamp(source.text, 0, 5)", "want": 5 },
    { "name": "clamp: not a number reads as 0", "expr": "clamp(source.word, 1, 10)", "want": 1 },
    { "name": "clamp: a range upside down is null", "expr": "clamp(5, 10, 0)", "want": null },
    { "name": "clamp: no upper bound", "expr": "clamp(5, 0)", "want": null },

    { "name": "format_number: en by default", "expr": "format_number(source.big, 2)", "want": "1,234,567.89" },
    { "name": "format_number: de", "expr": "format_number(source.big, 2, 'de')", "want": "1.234.567,89" },
    { "name": "format_number: fr groups with a narrow no-break space", "expr": "format_number(source.big, 2, 'fr')", "want": "1 234 567,89" },
    { "name": "format_number: id", "expr": "format_number(source.big, 2, 'id')", "want": "1.234.567,89" },
    { "name": "format_number: a region is read by its language", "expr": "format_number(source.big, 2, 'en-US')", "want": "1,234,567.89" },
    { "name": "format_number: an underscore region too", "expr": "format_number(source.big, 2, 'de_DE')", "want": "1.234.567,89" },
    { "name": "format_number: a negative", "expr": "format_number(-1234.5, 2, 'de')", "want": "-1.234,50" },
    { "name": "format_number: no decimals", "expr": "format_number(1234, 0)", "want": "1,234" },
    { "name": "format_number: rounds half away from zero, as round does", "expr": "format_number(2.5, 0)", "want": "3" },
    { "name": "format_number: decimals default to 0", "expr": "format_number(source.qty)", "want": "3" },
    { "name": "format_number: under a thousand has no separator", "expr": "format_number(source.neg, 1)", "want": "-12.5" },
    { "name": "format_number: not a number", "expr": "format_number(source.word, 2)", "want": null },
    { "name": "format_number: an unknown locale", "expr": "format_number(1, 2, 'xx')", "want": null },
    { "name": "format_number: negative decimals", "expr": "format_number(1, -1)", "want": null },
    { "name": "format_number: too many decimals", "expr": "format_number(1, 21)", "want": null },
    { "name": "format_number: decimals that are not a number", "expr": "format_number(1, 'a')", "want": null },
    { "name": "format_number: no arguments", "expr": "format_number()", "want": null }
  ]
}
