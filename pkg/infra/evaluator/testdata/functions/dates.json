{
  "_comment": [
    "date_add, date_diff, date_trunc, to_timezone, parse_date, weekday and",
    "epoch_ms, as the engine runs them. Every file in this directory is read by",
    "pkg/infra/evaluator/function_fixture_test.go; each case is a whole",
    "expression evaluated against `source`.",
    "",
    "A date is read as toDate reads one -- ISO 8601, 2006-01-02 15:04:05,",
    "2006-01-02, RFC 1123, or a number of seconds since 1970, which is UTC -- and",
    "a date answered is ISO 8601 in the date's own offset. A date that cannot be",
    "read, a unit or a zone that does not exist, is null.",
    "",
    "date_add takes a Go duration (90m, 1h30m, -15s) plus d for days and w for",
    "weeks; a day is 24 hours. date_diff(a, b, unit) is a minus b in whole units,",
    "cut towards zero; month and year count calendar months. weekday is ISO:",
    "Monday 1 to Sunday 7. date_trunc's week starts on Monday."
  ],
  "source": {
    "ts": "2024-03-09T14:30:00Z",
    "later": "2024-03-16T14:30:00Z",
    "day": "2024-03-09",
    "jkt": "2024-03-09T14:30:00+07:00",
    "frac": "2024-03-09T14:30:00.250Z",
    "epoch": 1710000000,
    "us": "03/09/2024",
    "word": "not a date"
  },
  "cases": [
    { "name": "date_add: days", "expr": "date_add(source.ts, '7d')", "want": "2024-03-16T14:30:00Z" },
    { "name": "date_add: a negative week", "expr": "date_add(source.ts, '-1w')", "want": "2024-03-02T14:30:00Z" },
    { "name": "date_add: days with hours and minutes", "expr": "date_add(source.ts, '1d12h30m')", "want": "2024-03-11T03:00:00Z" },
    { "name": "date_add: a Go duration", "expr": "date_add(source.ts, '90m')", "want": "2024-03-09T16:00:00Z" },
    { "name": "date_add: a fraction of a day", "expr": "date_add(source.ts, '1.5d')", "want": "2024-03-11T02:30:00Z" },
    { "name": "date_add: keeps the offset", "expr": "date_add(source.jkt, '1h')", "want": "2024-03-09T15:30:00+07:00" },
    { "name": "date_add: a date alone is midnight UTC", "expr": "date_add(source.day, '1d')", "want": "2024-03-10T00:00:00Z" },
    { "name": "date_add: keeps fractions of a second", "expr": "date_add(source.frac, '1s')", "want": "2024-03-09T14:30:01.25Z" },
    { "name": "date_add: seconds since 1970 are UTC", "expr": "date_add(source.epoch, '1d')", "want": "2024-03-10T16:00:00Z" },
    { "name": "date_add: not a date", "expr": "date_add(source.word, '1d')", "want": null },
    { "name": "date_add: words are not a duration", "expr": "date_add(source.ts, '7 days')", "want": null },
    { "name": "date_add: years are not a unit", "expr": "date_add(source.ts, '1y')", "want": null },
    { "name": "date_add: nothing to add", "expr": "date_add(source.ts, '')", "want": null },
    { "name": "date_add: too long to add", "expr": "date_add(source.ts, '100000000w')", "want": null },
    { "name": "date_add: no duration", "expr": "date_add(source.ts)", "want": null },

    { "name": "date_diff: days, a minus b", "expr": "date_diff(source.later, source.ts, 'day')", "want": 7 },
    { "name": "date_diff: negative when a is earlier", "expr": "date_diff(source.ts, source.later, 'day')", "want": -7 },
    { "name": "date_diff: days by default", "expr": "date_diff(source.later, source.ts)", "want": 7 },
    { "name": "date_diff: hours", "expr": "date_diff(source.later, source.ts, 'hour')", "want": 168 },
    { "name": "date_diff: weeks", "expr": "date_diff(source.later, source.ts, 'week')", "want": 1 },
    { "name": "date_diff: minutes", "expr": "date_diff(source.later, source.ts, 'minutes')", "want": 10080 },
    { "name": "date_diff: seconds", "expr": "date_diff(source.later, source.ts, 's')", "want": 604800 },
    { "name": "date_diff: milliseconds", "expr": "date_diff(source.later, source.ts, 'ms')", "want": 604800000 },
    { "name": "date_diff: across offsets", "expr": "date_diff(source.jkt, source.ts, 'hour')", "want": -7 },
    { "name": "date_diff: a part of a day is cut", "expr": "date_diff('2024-03-09T23:00:00Z', source.ts, 'day')", "want": 0 },
    { "name": "date_diff: a month not yet complete", "expr": "date_diff('2024-05-08', source.day, 'month')", "want": 1 },
    { "name": "date_diff: whole months", "expr": "date_diff('2024-05-09', source.day, 'month')", "want": 2 },
    { "name": "date_diff: months backwards", "expr": "date_diff(source.day, '2024-05-08', 'month')", "want": -1 },
    { "name": "date_diff: a whole year", "expr": "date_diff('2025-03-09', source.day, 'year')", "want": 1 },
    { "name": "date_diff: a year not yet complete", "expr": "date_diff('2025-03-08', source.day, 'year')", "want": 0 },
    { "name": "date_diff: not a date", "expr": "date_diff(source.word, source.ts, 'day')", "want": null },
    { "name": "date_diff: an unknown unit", "expr": "date_diff(source.ts, source.ts, 'fortnight')", "want": null },
    { "name": "date_diff: one date", "expr": "date_diff(source.ts)", "want": null },

    { "name": "date_trunc: day", "expr": "date_trunc(source.ts, 'day')", "want": "2024-03-09T00:00:00Z" },
    { "name": "date_trunc: hour", "expr": "date_trunc(source.ts, 'hour')", "want": "2024-03-09T14:00:00Z" },
    { "name": "date_trunc: minute drops seconds and fractions", "expr": "date_trunc(source.frac, 'minute')", "want": "2024-03-09T14:30:00Z" },
    { "name": "date_trunc: second drops fractions", "expr": "date_trunc(source.frac, 'second')", "want": "2024-03-09T14:30:00Z" },
    { "name": "date_trunc: week starts on Monday", "expr": "date_trunc(source.ts, 'week')", "want": "2024-03-04T00:00:00Z" },
    { "name": "date_trunc: month", "expr": "date_trunc(source.ts, 'month')", "want": "2024-03-01T00:00:00Z" },
    { "name": "date_trunc: year", "expr": "date_trunc(source.ts, 'year')", "want": "2024-01-01T00:00:00Z" },
    { "name": "date_trunc: in the date's own offset", "expr": "date_trunc(source.jkt, 'day')", "want": "2024-03-09T00:00:00+07:00" },
    { "name": "date_trunc: an unknown unit", "expr": "date_trunc(source.ts, 'quarter')", "want": null },
    { "name": "date_trunc: not a date", "expr": "date_trunc(source.word, 'day')", "want": null },
    { "name": "date_trunc: no unit", "expr": "date_trunc(source.ts)", "want": null },

    { "name": "to_timezone: UTC to Jakarta", "expr": "to_timezone(source.ts, 'Asia/Jakarta')", "want": "2024-03-09T21:30:00+07:00" },
    { "name": "to_timezone: Jakarta to UTC", "expr": "to_timezone(source.jkt, 'UTC')", "want": "2024-03-09T07:30:00Z" },
    { "name": "to_timezone: before a daylight-saving change", "expr": "to_timezone(source.ts, 'America/New_York')", "want": "2024-03-09T09:30:00-05:00" },
    { "name": "to_timezone: after a daylight-saving change", "expr": "to_timezone(source.later, 'America/New_York')", "want": "2024-03-16T10:30:00-04:00" },
    { "name": "to_timezone: a zone that does not exist", "expr": "to_timezone(source.ts, 'Mars/Olympus')", "want": null },
    { "name": "to_timezone: no zone is not UTC", "expr": "to_timezone(source.ts, '')", "want": null },
    { "name": "to_timezone: the server's zone is not offered", "expr": "to_timezone(source.ts, 'Local')", "want": null },
    { "name": "to_timezone: not a date", "expr": "to_timezone(source.word, 'UTC')", "want": null },
    { "name": "to_timezone: one argument", "expr": "to_timezone(source.ts)", "want": null },

    { "name": "parse_date: a layout", "expr": "parse_date(source.us, '01/02/2006')", "want": "2024-03-09T00:00:00Z" },
    { "name": "parse_date: with a time", "expr": "parse_date('09 Mar 2024 14:30', '02 Jan 2006 15:04')", "want": "2024-03-09T14:30:00Z" },
    { "name": "parse_date: text the layout does not fit", "expr": "parse_date(source.us, '2006-01-02')", "want": null },
    { "name": "parse_date: a missing field", "expr": "parse_date(source.missing, '2006-01-02')", "want": null },
    { "name": "parse_date: no layout", "expr": "parse_date(source.us)", "want": null },

    { "name": "weekday: Saturday", "expr": "weekday(source.ts)", "want": 6 },
    { "name": "weekday: Sunday is 7", "expr": "weekday('2024-03-10')", "want": 7 },
    { "name": "weekday: Monday is 1", "expr": "weekday('2024-03-04')", "want": 1 },
    { "name": "weekday: in the date's own offset", "expr": "weekday('2024-03-10T01:00:00+07:00')", "want": 7 },
    { "name": "weekday: not a date", "expr": "weekday(source.word)", "want": null },
    { "name": "weekday: no arguments", "expr": "weekday()", "want": null },

    { "name": "epoch_ms: an ISO date", "expr": "epoch_ms(source.ts)", "want": 1709994600000 },
    { "name": "epoch_ms: keeps milliseconds", "expr": "epoch_ms(source.frac)", "want": 1709994600250 },
    { "name": "epoch_ms: an offset", "expr": "epoch_ms(source.jkt)", "want": 1709969400000 },
    { "name": "epoch_ms: seconds since 1970", "expr": "epoch_ms(source.epoch)", "want": 1710000000000 },
    { "name": "epoch_ms: not a date", "expr": "epoch_ms(source.word)", "want": null },
    { "name": "epoch_ms: no arguments", "expr": "epoch_ms()", "want": null }
  ]
}
