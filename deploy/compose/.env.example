# Copy to .env next to compose.yaml. The same token goes to Hermod
# (HERMOD_ML_WORKER_TOKEN) and the worker (HERMOD_ML_TOKEN).
# Generate one with: openssl rand -hex 32
HERMOD_ML_TOKEN=

# The release of both images: latest, or a version such as 1.18.0.
HERMOD_VERSION=latest

# Empty for the slim worker; -dl for the deep-learning worker (amd64 only).
HERMOD_ML_VARIANT=

# The port Hermod's console and API are published on.
HERMOD_PORT=4000
